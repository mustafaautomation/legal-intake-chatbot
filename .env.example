# Leave these empty for the deterministic demo. CI and `npm run build` need none of them.
LLM_PROVIDER=demo
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Webhook verify tokens. The routes default to demo-verify-token when unset.
WHATSAPP_VERIFY_TOKEN=demo-verify-token
WHATSAPP_TOKEN=
MESSENGER_VERIFY_TOKEN=demo-verify-token
MESSENGER_PAGE_TOKEN=

# Optional. On Vercel the store uses /tmp when this is unset.
DATA_PATH=data/intake.json
